# Copy to .env and enter your key, or leave it blank to enter it interactively in CLI.
# Never commit .env. --ask-api-key lets you enter another key for one run.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT=120
TRANSLATION_BATCH_SIZE=40
TRANSLATION_CONTEXT_SIZE=5
TRANSLATION_RETRIES=3
TRANSLATION_RETRY_DELAY=5
GLOSSARY_PATH=glossary.json

# ROI ratios relative to the image width / height.
SAMPLE_FPS=4
ROI_LEFT=0.05
ROI_TOP=0.65
ROI_RIGHT=0.95
ROI_BOTTOM=0.98
OCR_CONFIDENCE=0.60
FUZZY_THRESHOLD=0.84
OCR_MAX_GAP=0.35
OCR_MIN_DURATION=0.20
OCR_DEVICE=gpu:0
OCR_LANG=ch
OCR_DET_MODEL=PP-OCRv5_mobile_det
OCR_REC_MODEL=PP-OCRv5_mobile_rec

TTS_VOICE=vi-VN-HoaiMyNeural
# Version 1 keeps normal speed.
TTS_RATE=+0%
TTS_VOLUME=+0%
# Advanced F0 adjustment only; it does not select another Edge speaker.
# The web slider stores a per-project value from -20Hz to +20Hz and overrides
# this fallback. .env accepts the same range; +0Hz is neutral.
TTS_PITCH=+0Hz
TTS_RETRIES=6
TTS_RETRY_DELAY=5
TTS_REQUEST_INTERVAL=1
TTS_TIMEOUT=90
AUDIO_SAMPLE_RATE=24000
ORIGINAL_VOLUME=0.15
VOICE_VOLUME=1.0
VOICE_SPEED=1.0
# Playback speed for the optional review copy made before OCR. Both the
# Chinese video and original audio are slowed by this factor.
SOURCE_SPEED=0.80
# GPU H.264 encoding for the review video. Set libx264 only on a machine
# without a working NVIDIA NVENC encoder.
SLOW_VIDEO_ENCODER=h264_nvenc

# Offline RVC + RMVPE voice conversion. Run tools\setup_rvc_gpu.ps1 once to
# create this separate CUDA runtime; it does not modify the PaddleOCR .venv.
RVC_ROOT=.tools/rvc
RVC_PYTHON=.tools/rvc-runtime/Scripts/python.exe
VOICE_MODELS_DIR=models/rvc
RVC_CUDA_DEVICE=0

# Video effects at final export. The Vietnamese SRT is burned after MIRROR_VIDEO,
# so Vietnamese remains readable. The blur coordinates target hard Chinese subtitles.
BLUR_CHINESE_SUBTITLES=false
BLUR_LEFT=0.05
BLUR_TOP=0.80
BLUR_RIGHT=0.95
BLUR_BOTTOM=0.96
BLUR_STRENGTH=14
MIRROR_VIDEO=false

# OCR tùy chỉnh cho tên nhân vật/chú thích nằm giữa khung hình. Trên web, hãy
# bấm “Khoanh vùng trên video”; các giá trị dưới đây được lưu riêng theo project.
# SRT tạo ra là <video>_annotation_zh.srt và <video>_annotation_vi.srt; không
# đưa vào TTS. Nếu dùng CLI, chỉnh vùng 0..1 này rồi truyền --annotation-srt
# cho burn_subtitle.py hoặc mix_audio.py.
ANNOTATION_OCR_ENABLED=false
ANNOTATION_LEFT=0.20
ANNOTATION_TOP=0.20
ANNOTATION_RIGHT=0.80
ANNOTATION_BOTTOM=0.50
ANNOTATION_FONT_SIZE=28
# Vị trí dọc của chữ Việt (dịch hoặc SRT nhập trực tiếp), tính từ phía trên
# video. 0.12 là cao. Chỉ đổi vị trí chèn; không đổi vùng OCR ở trên.
ANNOTATION_DISPLAY_Y=0.12

# Logo được chọn trong giao diện web và lưu riêng bên trong project. Các giá
# trị này cũng có thể đặt trong .env khi dùng --logo ở burn_subtitle.py/mix_audio.py.
BURN_LOGO=false
LOGO_POSITION=top-right
LOGO_WIDTH_PERCENT=12
LOGO_OPACITY=0.85
LOGO_MARGIN_PERCENT=3

# Bare command names use PATH. Full paths may contain Unicode and spaces.
# Use single quotes for full Windows paths, for example:
# FFMPEG_BIN='C:\Tools\ffmpeg\bin\ffmpeg.exe'
# FFPROBE_BIN='C:\Tools\ffmpeg\bin\ffprobe.exe'
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
BURN_FONT=Arial
BURN_FONT_SIZE=24

# Relative config paths resolve from the project directory.
OUTPUT_DIR=output
AUDIO_DIR=audio
TEMP_DIR=temp
